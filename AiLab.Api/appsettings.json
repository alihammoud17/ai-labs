{
  "Chat": {
    "Provider": "ollama",
    "Model": "llama3.2",
    "OllamaUrl": "http://localhost:11434"
  },
  "Resilience": {
    "AttemptTimeoutSeconds": 60,
    "MaxRetries": 2,
    "RequestTimeoutSeconds": 240,
    "MaxToolIterations": 3
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft.Extensions.AI": "Debug",
        "Microsoft.Hosting.Lifetime": "Information",
        "AiLab": "Information"
      }
    }
  },
  "AllowedHosts": "*"
}
