{
  "Chat": {
    "Provider": "anthropic",
    "Model": "claude-haiku-5-5",
    "OllamaUrl": "http://localhost:11434"
  },
  "Embedding": {
    "Provider": "ollama",
    "Model": "nomic-embed-text",
    "OllamaUrl": "http://localhost:11434",
    "UseTaskPrefixes": false
  },
  "VectorStore": {
    "Provider": "postgres",
    "Collection": "corpus"
  },
  "Ask": {
    "Top": 5,
    "MaxTop": 10,
    "Chunker": "heading",
    "SearchMode": "vector",
    "MaxDistance": 0.50,
    "MaxQuestionChars": 500,
    "MaxOutputTokens": 2000,
    "PromptPath": "prompts/ask-v1.md",
    "PermitsPerMinute": 10
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft.Extensions.AI": "Debug",
        "Microsoft.Hosting.Lifetime": "Information",
        "AiLab": "Information"
      }
    }
  },
  "AllowedHosts": "*"
}
