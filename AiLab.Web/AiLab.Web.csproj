<Project Sdk="Microsoft.NET.Sdk">

  <!-- What the two web hosts (AiLab.Api, AiLab.Rag) share: the { error, code } error responses. ASP.NET Core only, no packages.
       Separate from Infrastructure so the console, which references Infrastructure, doesn't pull in ASP.NET Core. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AiLab.Domain\AiLab.Domain.csproj" />
  </ItemGroup>

</Project>
