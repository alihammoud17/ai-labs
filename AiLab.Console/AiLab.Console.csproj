    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>081e3468-5d37-4a03-8004-d2e99d582578</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AiLab.Core\AiLab.Core.csproj" />
