{
  "Chat": {
    "Provider": "ollama",
    "Model": "llama3.2",
    "OllamaUrl": "http://localhost:11434"
  },
  "Embedding": {
    "Provider": "ollama",
    "Model": "nomic-embed-text",
    "OllamaUrl": "http://localhost:11434"
  },
  "VectorStore": {
    "Provider": "postgres",
    "Collection": "chunks"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft.Extensions.AI": "Debug",
        "Microsoft.Hosting.Lifetime": "Information",
        "AiLab": "Information"
      }
    }
  },
  "AllowedHosts": "*"
}
