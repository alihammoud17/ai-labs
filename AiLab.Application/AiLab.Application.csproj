<Project Sdk="Microsoft.NET.Sdk">

  <!-- Services and business logic. Talks to models only through IChatClient and to the outside world through Domain interfaces. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AiLab.Domain\AiLab.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The full package, not just Abstractions: GetResponseAsync<T> and ChatResponse<T> live here -->
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
  </ItemGroup>

</Project>
