<Project Sdk="Microsoft.NET.Sdk">

  <!-- Integration tests for AiLab.Rag. Separate from AiLab.Api.Tests: one test project can't host two top-level Programs. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AiLab.Rag\AiLab.Rag.csproj" />
    <ProjectReference Include="..\AiLab.Application\AiLab.Application.csproj" />
    <ProjectReference Include="..\AiLab.Domain\AiLab.Domain.csproj" />
    <ProjectReference Include="..\AiLab.Infrastructure\AiLab.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

</Project>
