<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Same id as AiLab.Console, so both read the one Anthropic:ApiKey -->
    <UserSecretsId>081e3468-5d37-4a03-8004-d2e99d582578</UserSecretsId>
  </PropertyGroup>

  <!-- The test tickets, read at runtime by the Swagger examples and the ticket eval (the content root is the output folder) -->
  <ItemGroup>
    <None Include="TestTickets\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AiLab.Application\AiLab.Application.csproj" />
    <ProjectReference Include="..\AiLab.Domain\AiLab.Domain.csproj" />
    <ProjectReference Include="..\AiLab.Infrastructure\AiLab.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
  </ItemGroup>

</Project>
